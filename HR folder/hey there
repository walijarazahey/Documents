import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
sns.set_style("whitegrid")
pd.set_option('display.width', 200)


print("1. PROBLEM STATEMENT & DATASET OVERVIEW")
print("Objective: Analyze 500 employee records to find salary trends")
print("Target: Understand what factors affect salary and employee level\n")


np.random.seed(42)
n = 500
data = {
    'employee_id': range(1001, 1001 + n),
    'age': np.random.randint(22, 60, n),
    'gender': np.random.choice(['Male', 'Female'], n),
    'department': np.random.choice(['IT', 'HR', 'Sales', 'Finance'], n),
    'location': np.random.choice(['Peshawar', 'Lahore', 'Karachi', 'Islamabad', np.nan], n, p=[0.25,0.25,0.25,0.2,0.05]),
    'salary': np.random.randint(40000, 120000, n),
    'hire_date': pd.to_datetime(np.random.choice(pd.date_range('2018-01-01', '2024-12-31'), n)),
        
    'performance': np.random.randint(1, 6, n)
}
df = pd.DataFrame(data)
df.loc[np.random.choice(df.index, 40), 'age'] = np.nan
df.loc[np.random.choice(df.index, 25), 'salary'] = np.nan
df.loc[5, 'hire_date'] = '2027-01-01'
df.loc[10, 'salary'] = 500000
df = pd.concat([df, df.head(5)])

print("Dataset Shape:", df.shape)
print("\nDataset Info:\n")
df.info()


print("2. DATA CLEANING & QUALITY AUDIT")


print("\nA. Missing Values BEFORE Cleaning:")
print(df.isna().sum())
print("\nB. Duplicates BEFORE Cleaning:", df.duplicated(subset=['employee_id']).sum())

df = df.drop_duplicates(subset=['employee_id'])
df['hire_date'] = pd.to_datetime(df['hire_date'], errors='coerce')
df = df[df['hire_date'] <= pd.Timestamp('2026-01-01')]
df['location'] = df['location'].fillna(df['location'].mode()[0])
df['age'] = df['age'].fillna(df['age'].median())
df['salary'] = df['salary'].fillna(df.groupby('department')['salary'].transform('median'))

Q1 = df['salary'].quantile(0.25); Q3 = df['salary'].quantile(0.75); IQR = Q3 - Q1
df = df[~((df['salary'] < Q1-1.5*IQR) | (df['salary'] > Q3+1.5*IQR))]

print("\nC. Missing Values AFTER Cleaning:")
print(df.isna().sum())
print("Cleaned Dataset Shape:", df.shape)


print("3. EXPLORATORY DATA ANALYSIS & MANIPULATION")


print("\nA. Summary Statistics:")
print(df[['age', 'salary', 'performance']].describe().round(2))

df['years'] = 2026 - df['hire_date'].dt.year
df['hire_year'] = df['hire_date'].dt.year
df['salary_per_year'] = df['salary'] / (df['years'] + 1)
df['level'] = pd.cut(df['years'], bins=[0,2,5,50], labels=['Junior','Mid','Senior'])
df['is_high_performer'] = np.where(df['performance'] >= 4, 1, 0)

print("\nB. New Features Created: years, level, salary_per_year, is_high_performer")


print("4. DISTRIBUTION & VISUAL ANALYSIS")


plt.figure(figsize=(14,10))

# PLOT 1 : histogram
plt.subplot(2,2,1)
sns.histplot(df['salary'], bins=30, kde=True, color='skyblue')
plt.title("Plot 1: Salary Distribution")
plt.xlabel("Salary")

# PLOT 2: Bar Chart 
plt.subplot(2,2,2)
dept_count = df['department'].value_counts()
sns.barplot(x=dept_count.index, y=dept_count.values, color='steelblue')
plt.title("Plot 2: Headcount by Department")
plt.xlabel("Department"); plt.ylabel("Count")

# PLOT 3: Boxplot 
plt.subplot(2,2,3)
sns.boxplot(x='level', y='salary', data=df, color='orange', order=['Junior','Mid','Senior'])
plt.title("Plot 3: Salary by Employee Level")
plt.xlabel("Level"); plt.ylabel("Salary")

# PLOT 4: Heatmap
plt.subplot(2,2,4)
corr = df[['age', 'salary', 'years', 'performance']].corr()
sns.heatmap(corr, annot=True, cmap='coolwarm', fmt='.2f')
plt.title("Plot 4: Correlation Heatmap")

plt.tight_layout()
plt.show()


print("5. KEY BUSINESS TAKEAWAYS / CONCLUSION")


avg_salary_level = df.groupby('level')['salary'].mean().round(0)
avg_salary_dept = df.groupby('department')['salary'].mean().round(0)

print("\n1. PAY BY SENIORITY: Senior employees earn ~", avg_salary_level['Senior'],"vs Junior ~", avg_salary_level['Junior'])
 print("2. DEPARTMENT GAP: IT has highest avg salary of", avg_salary_dept['IT'],"while HR has lowest of", avg_salary_dept['HR'])
 print("3. EXPERIENCE MATTERS: Correlation between years and salary is", corr.loc['years','salary'])
 print("4. DATA QUALITY: Dataset is now clean and ready for ML models.")
  print("5. RECOMMENDATION: Review HR and Sales salary bands to reduce pay gap vs IT.")

print("\n=== ANALYSIS COMPLETE ===")}
